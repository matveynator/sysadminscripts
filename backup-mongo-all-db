#!/bin/bash
set -euo pipefail

DAYS_TO_KEEP=30
BASE_BACKUP_PATH="/backup/$(hostname)/mongo"

LANG=C

CMDNAME="$(basename "$0")"
TMP_DIR="/tmp/${CMDNAME}"
LOCK_FILE="${TMP_DIR}/lock"

mkdir -p "$TMP_DIR"

if [ -e "$LOCK_FILE" ]; then
    echo "ERROR: already running with lockfile $LOCK_FILE"
    exit 1
fi

touch "$LOCK_FILE"

cleanup() {
    rm -rf "$TMP_DIR"
}

trap cleanup EXIT SIGTERM

HOSTNAME="$(hostname)"
DAY="$(date +%y%m%d-%H-%M-%S)"

BACKUP_PATH="${BASE_BACKUP_PATH}/${DAY}"
DUMP_PATH="${BACKUP_PATH}/dump"

mkdir -p "$DUMP_PATH"

echo "$(date -Is) Starting MongoDB backup"
echo "Destination: $DUMP_PATH"

if ! nice -n 19 ionice -c 3 \
    mongodump \
    --host 127.0.0.1 \
    --out "$DUMP_PATH"
then
    echo "ERROR: MongoDB backup FAILED"
    echo "Host: $HOSTNAME"
    echo "Path: $BACKUP_PATH"

    rm -rf "$BACKUP_PATH"
    exit 1
fi

echo "$(date -Is) MongoDB backup completed"
du -sh "$DUMP_PATH"

#
# Mark completed backup
#

date -Is > "${BACKUP_PATH}/complete"

#
# Remove backups older than configured retention
#

find "$BASE_BACKUP_PATH" \
    -mindepth 1 \
    -maxdepth 1 \
    -type d \
    -mtime +"$DAYS_TO_KEEP" \
    -print \
    -exec rm -rf {} +

echo "$(date -Is) Old MongoDB backups cleaned"
echo "Retention: ${DAYS_TO_KEEP} days"
echo "Backup path: $BACKUP_PATH"
