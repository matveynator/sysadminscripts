########################################################################
# STATIC /32 GATEWAY INSIDE CONTAINER
#
# Для адреса /32:
#
#   IP контейнера:  A.B.C.D/32
#   Gateway:        основной IPv4 хоста
#
# Сначала делаем gateway достижимым непосредственно через eth0:
#
#   ip route replace GATEWAY/32 dev eth0 scope link
#
# Потом default:
#
#   ip route replace default via GATEWAY dev eth0
########################################################################

header "Настройка gateway внутри контейнера"

mkdir -p "$ROOTFS/etc/systemd/system"

cat > "$ROOTFS/etc/systemd/system/lxc-static-gateway.service" <<EOF
[Unit]
Description=LXC static /32 gateway via host ${GATEWAY}
After=local-fs.target
Before=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'ip link set eth0 up; ip route replace ${GATEWAY}/32 dev eth0 scope link; ip route replace default via ${GATEWAY} dev eth0'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

# Enable offline, до первого запуска контейнера.
if command -v systemctl >/dev/null 2>&1; then

    systemctl \
        --root="$ROOTFS" \
        enable \
        lxc-static-gateway.service \
        2>/dev/null || true

fi

# Дополнительная гарантия, если старый systemctl --root
# почему-либо не создал wants symlink.
