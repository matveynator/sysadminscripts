#!/bin/bash
set -Eeuo pipefail

########################################################################
# DEFAULTS
########################################################################

IMAGE_SERVER="images.linuxcontainers.org"

DEFAULT_NAME="wartank"
DEFAULT_DISK="200G"
DEFAULT_MEMORY="120G"

DEFAULT_BRIDGE="br0"

DEFAULT_IPV4="213.133.127.244"
DEFAULT_PREFIX="32"

DEFAULT_BACKUP_ROOT="/backup/lxc"

########################################################################
# COLORS
########################################################################

if [ -t 1 ]; then
    BOLD=$'\033[1m'
    GREEN=$'\033[32m'
    YELLOW=$'\033[33m'
    RED=$'\033[31m'
    CYAN=$'\033[36m'
    RESET=$'\033[0m'
else
    BOLD=""
    GREEN=""
    YELLOW=""
    RED=""
    CYAN=""
    RESET=""
fi

########################################################################
# HELPERS
########################################################################

header() {
    echo
    echo "${BOLD}${CYAN}=================================================================${RESET}"
    echo "${BOLD}$*${RESET}"
    echo "${BOLD}${CYAN}=================================================================${RESET}"
}

die() {
    echo
    echo "${BOLD}${RED}ERROR: $*${RESET}" >&2
    exit 1
}

warn() {
    echo "${YELLOW}WARNING: $*${RESET}"
}

ok() {
    echo "${GREEN}$*${RESET}"
}

ask() {
    local prompt="$1"
    local default="${2:-}"
    local answer

    if [ -n "$default" ]; then
        read -r -p "$prompt [$default]: " answer
        echo "${answer:-$default}"
    else
        read -r -p "$prompt: " answer
        echo "$answer"
    fi
}

yesno() {
    local prompt="$1"
    local default="${2:-y}"
    local answer

    if [ "$default" = "y" ]; then
        read -r -p "$prompt [Y/n]: " answer
        answer="${answer:-y}"
    else
        read -r -p "$prompt [y/N]: " answer
        answer="${answer:-n}"
    fi

    case "$answer" in
        y|Y|yes|YES|Yes|д|Д|да|ДА|Да)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

human_bytes() {
    numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "$1"
}

parse_size() {
    local value="$1"

    value="${value^^}"
    value="${value//IB/}"
    value="${value//B/}"

    numfmt --from=iec "$value" 2>/dev/null
}


########################################################################
# LIVE PROGRESS
########################################################################

run_with_progress() {
    local title="$1"
    shift

    local log_file
    log_file="$(mktemp)"

    local start_time
    start_time="$(date +%s)"

    local cache_dir="/var/cache/lxc/download"

    local cache_before=0
    local rootfs_before=0

    [ -d "$cache_dir" ] && \
        cache_before="$(du -sb "$cache_dir" 2>/dev/null | awk '{print $1}')" || true

    [ -d "${LXC_DIR:-/nonexistent}" ] && \
        rootfs_before="$(du -sb "${LXC_DIR}" 2>/dev/null | awk '{print $1}')" || true

    cache_before="${cache_before:-0}"
    rootfs_before="${rootfs_before:-0}"

    echo
    echo "${BOLD}${title}${RESET}"
    echo

    if command -v stdbuf >/dev/null 2>&1; then
        stdbuf -oL -eL "$@" >"$log_file" 2>&1 &
    else
        "$@" >"$log_file" 2>&1 &
    fi

    local pid=$!

    local width=28
    local tick=0
    local pos
    local bar
    local i
    local now
    local elapsed
    local mins
    local secs
    local cache_now
    local rootfs_now
    local cache_delta
    local rootfs_delta
    local cache_human
    local rootfs_human
    local last_line

    while kill -0 "$pid" 2>/dev/null; do

        now="$(date +%s)"
        elapsed=$((now - start_time))
        mins=$((elapsed / 60))
        secs=$((elapsed % 60))

        pos=$((tick % (width - 4)))

        bar=""

        for ((i=0; i<width; i++)); do
            if [ "$i" -ge "$pos" ] && [ "$i" -lt $((pos + 4)) ]; then
                bar="${bar}#"
            else
                bar="${bar}."
            fi
        done

        cache_now=0
        rootfs_now=0

        if [ -d "$cache_dir" ]; then
            cache_now="$(du -sb "$cache_dir" 2>/dev/null | awk '{print $1}')" || true
        fi

        if [ -d "${LXC_DIR:-/nonexistent}" ]; then
            rootfs_now="$(du -sb "${LXC_DIR}" 2>/dev/null | awk '{print $1}')" || true
        fi

        cache_now="${cache_now:-0}"
        rootfs_now="${rootfs_now:-0}"

        cache_delta=$((cache_now - cache_before))
        rootfs_delta=$((rootfs_now - rootfs_before))

        [ "$cache_delta" -lt 0 ] && cache_delta=0
        [ "$rootfs_delta" -lt 0 ] && rootfs_delta=0

        cache_human="$(numfmt --to=iec --suffix=B "$cache_delta" 2>/dev/null || echo "${cache_delta}B")"
        rootfs_human="$(numfmt --to=iec --suffix=B "$rootfs_delta" 2>/dev/null || echo "${rootfs_delta}B")"

        last_line="$(
            tail -n 1 "$log_file" 2>/dev/null |
            tr -d '\r' |
            cut -c1-65
        )"

        printf '\r\033[K  [%s] %02d:%02d  cache +%-8s rootfs +%-8s' \
            "$bar" \
            "$mins" \
            "$secs" \
            "$cache_human" \
            "$rootfs_human"

        if [ -n "$last_line" ]; then
            printf '  %s' "$last_line"
        fi

        tick=$((tick + 1))
        sleep 1
    done

    local rc=0

    if wait "$pid"; then
        rc=0
    else
        rc=$?
    fi

    now="$(date +%s)"
    elapsed=$((now - start_time))
    mins=$((elapsed / 60))
    secs=$((elapsed % 60))

    printf '\r\033[K'

    if [ "$rc" -eq 0 ]; then

        echo "${GREEN}OK:${RESET} ${title} — ${mins}m ${secs}s"

        if [ -s "$log_file" ]; then
            echo
            echo "${BOLD}Последние сообщения:${RESET}"
            tail -n 12 "$log_file"
        fi

        rm -f "$log_file"
        return 0

    else

        echo "${RED}${BOLD}FAILED:${RESET} ${title}"
        echo
        echo "${RED}Exit code: ${rc}${RESET}"
        echo
        echo "${BOLD}Последние 80 строк лога:${RESET}"
        echo "-----------------------------------------------------------------"

        tail -n 80 "$log_file" || true

        echo "-----------------------------------------------------------------"
        echo "Полный временный лог:"
        echo "  $log_file"
        echo

        return "$rc"
    fi
}

########################################################################
# ROOT
########################################################################

[ "${EUID}" -eq 0 ] || die "Запусти скрипт от root"

########################################################################
# PACKAGES
########################################################################

header "Проверка программ"

MISSING=()

command -v lxc-create >/dev/null 2>&1 || MISSING+=(lxc)
command -v lvcreate   >/dev/null 2>&1 || MISSING+=(lvm2)
command -v mkfs.xfs   >/dev/null 2>&1 || MISSING+=(xfsprogs)
command -v ip         >/dev/null 2>&1 || MISSING+=(iproute2)
command -v rsync      >/dev/null 2>&1 || MISSING+=(rsync)
command -v curl       >/dev/null 2>&1 || MISSING+=(curl)
command -v wget       >/dev/null 2>&1 || MISSING+=(wget)
command -v gpg        >/dev/null 2>&1 || MISSING+=(gnupg)
command -v numfmt     >/dev/null 2>&1 || MISSING+=(coreutils)

if [ "${#MISSING[@]}" -gt 0 ]; then
    echo "Не хватает пакетов:"
    printf '  %s\n' "${MISSING[@]}"

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        "${MISSING[@]}" \
        ca-certificates
fi

update-ca-certificates >/dev/null 2>&1 || true

ok "Программы OK"

########################################################################
# CONTAINER NAME
########################################################################

header "Имя контейнера"

NAME="$(ask "Имя контейнера" "$DEFAULT_NAME")"

[[ "$NAME" =~ ^[A-Za-z0-9_.-]+$ ]] || \
    die "Недопустимое имя контейнера: $NAME"

LXC_DIR="/var/lib/lxc/${NAME}"
BACKUP_DIR="${DEFAULT_BACKUP_ROOT}/${NAME}"

########################################################################
# STORAGE
########################################################################

header "Диски / LVM"

echo
echo "${BOLD}Physical Volumes:${RESET}"
pvs -o pv_name,vg_name,pv_size,pv_free

echo
echo "${BOLD}Volume Groups:${RESET}"
vgs -o vg_name,pv_count,lv_count,vg_size,vg_free

echo

mapfile -t VGS < <(
    vgs --noheadings -o vg_name |
    awk '{$1=$1; if ($1 != "") print $1}'
)

[ "${#VGS[@]}" -gt 0 ] || die "LVM Volume Groups не найдены"

echo "${BOLD}Выбери Volume Group:${RESET}"
echo

for i in "${!VGS[@]}"; do
    VG_TMP="${VGS[$i]}"

    FREE_TMP="$(
        vgs \
            --noheadings \
            --units b \
            --nosuffix \
            -o vg_free \
            "$VG_TMP" |
        awk '{
            gsub(/[<>]/, "", $1);
            printf "%.0f", $1
        }'
    )"

    SIZE_TMP="$(
        vgs \
            --noheadings \
            --units b \
            --nosuffix \
            -o vg_size \
            "$VG_TMP" |
        awk '{
            gsub(/[<>]/, "", $1);
            printf "%.0f", $1
        }'
    )"

    printf "  %2d) %-15s size=%-10s free=%s\n" \
        "$((i + 1))" \
        "$VG_TMP" \
        "$(human_bytes "$SIZE_TMP")" \
        "$(human_bytes "$FREE_TMP")"
done

echo

while true; do
    read -r -p "Номер VG [1]: " VG_NUM
    VG_NUM="${VG_NUM:-1}"

    if [[ "$VG_NUM" =~ ^[0-9]+$ ]] &&
       [ "$VG_NUM" -ge 1 ] &&
       [ "$VG_NUM" -le "${#VGS[@]}" ]; then
        break
    fi

    echo "Неверный номер."
done

VG="${VGS[$((VG_NUM - 1))]}"

VG_FREE="$(
    vgs \
        --noheadings \
        --units b \
        --nosuffix \
        -o vg_free \
        "$VG" |
    awk '{
        gsub(/[<>]/, "", $1);
        printf "%.0f", $1
    }'
)"

echo
ok "Выбран VG: $VG"
echo "Свободно: $(human_bytes "$VG_FREE")"

########################################################################
# DISK SIZE
########################################################################

echo

while true; do
    DISK="$(ask "Размер диска контейнера (например 50G, 200G, 1T)" "$DEFAULT_DISK")"

    if DISK_BYTES="$(parse_size "$DISK")"; then
        :
    else
        echo "Неверный размер: $DISK"
        continue
    fi

    if [ "$DISK_BYTES" -gt "$VG_FREE" ]; then
        echo
        warn "В $VG свободно только $(human_bytes "$VG_FREE")"
        echo "Ты запросил: $(human_bytes "$DISK_BYTES")"
        continue
    fi

    break
done

########################################################################
# MEMORY
########################################################################

header "Память"

free -h

HOST_MEMORY="$(
    awk '/MemTotal:/ {
        printf "%.0f", $2 * 1024
    }' /proc/meminfo
)"

echo
echo "Физическая RAM: $(human_bytes "$HOST_MEMORY")"

while true; do
    MEMORY="$(ask "Лимит RAM контейнера" "$DEFAULT_MEMORY")"

    if MEMORY_BYTES="$(parse_size "$MEMORY")"; then
        break
    fi

    echo "Неверный размер: $MEMORY"
done

if [ "$MEMORY_BYTES" -gt "$HOST_MEMORY" ]; then
    warn "Лимит контейнера больше физической RAM хоста."
    yesno "Всё равно оставить $MEMORY?" "n" || {
        MEMORY="$(ask "Лимит RAM контейнера" "$DEFAULT_MEMORY")"
        MEMORY_BYTES="$(parse_size "$MEMORY")" || die "Неверный размер памяти"
    }
fi

########################################################################
# CPU
########################################################################

header "CPU"

CPU_ONLINE="$(cat /sys/devices/system/cpu/online 2>/dev/null || true)"
CPU_COUNT="$(nproc --all)"

echo "CPU всего:       $CPU_COUNT"
echo "CPU online:      ${CPU_ONLINE:-unknown}"

if command -v lscpu >/dev/null 2>&1; then
    echo
    lscpu | grep -E \
        '^(Model name|Socket|Core|Thread|CPU\(s\)|NUMA node)' \
        || true
fi

echo
echo "Форматы:"
echo "  0-31"
echo "  0-7"
echo "  0-7,16-23"
echo "  0,2,4,6"
echo

DEFAULT_CPUS="${CPU_ONLINE:-0-$((CPU_COUNT - 1))}"

while true; do
    CPUSET="$(ask "Какие CPU отдать контейнеру" "$DEFAULT_CPUS")"

    if [[ "$CPUSET" =~ ^[0-9,-]+$ ]]; then
        break
    fi

    echo "Неверный формат CPUSET."
done

########################################################################
# DOWNLOAD IMAGE INDEX
########################################################################

header "Загрузка списка LXC-образов"

INDEX_TMP="$(mktemp)"

cleanup_tmp() {
    rm -f "$INDEX_TMP" 2>/dev/null || true
}

trap cleanup_tmp EXIT

IMAGE_INDEX_URL="https://${IMAGE_SERVER}/meta/1.0/index-system"

echo "$IMAGE_INDEX_URL"
echo

if command -v curl >/dev/null 2>&1; then
    curl \
        -4 \
        -fL \
        --retry 3 \
        --connect-timeout 15 \
        --max-time 90 \
        "$IMAGE_INDEX_URL" \
        -o "$INDEX_TMP" \
        || die "Не удалось скачать index-system"
else
    wget \
        -4 \
        --timeout=30 \
        --tries=3 \
        "$IMAGE_INDEX_URL" \
        -O "$INDEX_TMP" \
        || die "Не удалось скачать index-system"
fi

[ -s "$INDEX_TMP" ] || die "index-system пустой"

ok "Список образов загружен"

########################################################################
# ARCHITECTURE
########################################################################

HOST_ARCH_RAW="$(uname -m)"

case "$HOST_ARCH_RAW" in
    x86_64)
        HOST_ARCH="amd64"
        ;;
    aarch64)
        HOST_ARCH="arm64"
        ;;
    armv7l)
        HOST_ARCH="armhf"
        ;;
    *)
        HOST_ARCH="$HOST_ARCH_RAW"
        ;;
esac

mapfile -t ARCHES < <(
    awk -F';' '
        NF >= 6 && $3 != "" {
            print $3
        }
    ' "$INDEX_TMP" |
    sort -u
)

echo
echo "${BOLD}Доступные архитектуры:${RESET}"

DEFAULT_ARCH_NUM=1

for i in "${!ARCHES[@]}"; do
    printf "  %2d) %s" "$((i + 1))" "${ARCHES[$i]}"

    if [ "${ARCHES[$i]}" = "$HOST_ARCH" ]; then
        echo "  <-- этот сервер"
        DEFAULT_ARCH_NUM="$((i + 1))"
    else
        echo
    fi
done

echo

while true; do
    read -r -p "Архитектура [$DEFAULT_ARCH_NUM]: " ARCH_NUM
    ARCH_NUM="${ARCH_NUM:-$DEFAULT_ARCH_NUM}"

    if [[ "$ARCH_NUM" =~ ^[0-9]+$ ]] &&
       [ "$ARCH_NUM" -ge 1 ] &&
       [ "$ARCH_NUM" -le "${#ARCHES[@]}" ]; then
        break
    fi

    echo "Неверный номер."
done

ARCH="${ARCHES[$((ARCH_NUM - 1))]}"

########################################################################
# IMAGE SELECTOR
########################################################################

header "Доступные образы: $ARCH"

while true; do

    echo
    read -r -p \
        "Фильтр (debian / ubuntu / alpine / Enter = показать все): " \
        IMAGE_FILTER

mapfile -t IMAGES < <(
    awk -F';' -v arch="$ARCH" -v filter="$IMAGE_FILTER" '
        BEGIN {
            filter = tolower(filter)
        }

        NF >= 6 && $3 == arch {
            haystack = tolower($1 " " $2 " " $3 " " $4)

            if (filter == "" || index(haystack, filter) > 0) {
                print $0
            }
        }
    ' "$INDEX_TMP" |
    sort -t';' -k1,1 -k2,2 -k4,4
)


    if [ "${#IMAGES[@]}" -eq 0 ]; then
        echo
        warn "По такому фильтру образов нет."
        continue
    fi

    echo
    printf \
        "${BOLD}%4s  %-14s %-18s %-8s %-10s %-18s${RESET}\n" \
        "№" \
        "DISTRO" \
        "RELEASE" \
        "ARCH" \
        "VARIANT" \
        "BUILD"

    printf \
        "%4s  %-14s %-18s %-8s %-10s %-18s\n" \
        "----" \
        "--------------" \
        "------------------" \
        "--------" \
        "----------" \
        "------------------"

    for i in "${!IMAGES[@]}"; do

        IFS=';' read -r \
            IMG_DIST \
            IMG_RELEASE \
            IMG_ARCH \
            IMG_VARIANT \
            IMG_BUILD \
            IMG_PATH \
            <<< "${IMAGES[$i]}"

        printf \
            "%4d) %-14s %-18s %-8s %-10s %-18s\n" \
            "$((i + 1))" \
            "$IMG_DIST" \
            "$IMG_RELEASE" \
            "$IMG_ARCH" \
            "$IMG_VARIANT" \
            "$IMG_BUILD"
    done

    echo

    read -r -p "Номер образа (0 = другой фильтр): " IMAGE_NUM

    if [ "$IMAGE_NUM" = "0" ]; then
        continue
    fi

    if [[ "$IMAGE_NUM" =~ ^[0-9]+$ ]] &&
       [ "$IMAGE_NUM" -ge 1 ] &&
       [ "$IMAGE_NUM" -le "${#IMAGES[@]}" ]; then
        break
    fi

    echo "Неверный номер."
done

IFS=';' read -r \
    DISTRO \
    RELEASE \
    ARCH \
    VARIANT \
    BUILD \
    IMAGE_PATH \
    <<< "${IMAGES[$((IMAGE_NUM - 1))]}"

echo
ok "Выбран образ:"
echo
echo "  distro:   $DISTRO"
echo "  release:  $RELEASE"
echo "  arch:     $ARCH"
echo "  variant:  $VARIANT"
echo "  build:    $BUILD"
echo "  path:     $IMAGE_PATH"

########################################################################
# NETWORK
########################################################################

header "Сеть"

mapfile -t BRIDGES < <(
    ip -o link show type bridge 2>/dev/null |
    awk -F': ' '{print $2}' |
    cut -d@ -f1
)

if [ "${#BRIDGES[@]}" -gt 0 ]; then
    echo "Найденные bridge-интерфейсы:"
    printf '  %s\n' "${BRIDGES[@]}"
    echo
fi

BRIDGE="$(ask "Bridge" "$DEFAULT_BRIDGE")"

ip link show "$BRIDGE" >/dev/null 2>&1 || \
    die "Bridge $BRIDGE не существует"

IPV4="$(ask "IPv4 контейнера" "$DEFAULT_IPV4")"
PREFIX="$(ask "IPv4 prefix" "$DEFAULT_PREFIX")"

########################################################################
# MAIN/HOST IPv4
#
# Нам нужен НЕ upstream gateway вроде 46.4.211.1,
# а основной source IPv4 самого сервера.
########################################################################

HEAD_IP="$(
    ip -4 route get 1.1.1.1 2>/dev/null |
    awk '
        {
            for (i = 1; i <= NF; i++) {
                if ($i == "src") {
                    print $(i + 1)
                    exit
                }
            }
        }
    '
)"

# Fallback: первый global IPv4 хоста.
if [ -z "$HEAD_IP" ]; then
    HEAD_IP="$(
        ip -4 -o addr show scope global 2>/dev/null |
        awk '
            $2 != "lo" {
                split($4, a, "/")
                print a[1]
                exit
            }
        '
    )"
fi

[ -n "$HEAD_IP" ] ||     die "Не удалось определить основной IPv4 сервера"

echo
echo "Основной IPv4 сервера:"
echo "  $HEAD_IP"
echo

GATEWAY="$(ask "IPv4 gateway контейнера" "$HEAD_IP")"

########################################################################
# SUMMARY
########################################################################

header "Параметры нового контейнера"

echo
printf "  %-14s %s\n" "Имя:"       "$NAME"
printf "  %-14s %s\n" "VG:"        "$VG"
printf "  %-14s %s\n" "Диск:"      "$DISK"
printf "  %-14s %s\n" "RAM:"       "$MEMORY"
printf "  %-14s %s\n" "CPU:"       "$CPUSET"
echo
printf "  %-14s %s\n" "Образ:"     "$DISTRO"
printf "  %-14s %s\n" "Release:"   "$RELEASE"
printf "  %-14s %s\n" "Arch:"      "$ARCH"
printf "  %-14s %s\n" "Variant:"   "$VARIANT"
printf "  %-14s %s\n" "Build:"     "$BUILD"
echo
printf "  %-14s %s\n" "Bridge:"    "$BRIDGE"
printf "  %-14s %s/%s\n" "IPv4:"   "$IPV4" "$PREFIX"
printf "  %-14s %s\n" "Gateway:"   "$GATEWAY"
echo
printf "  %-14s %s\n" "LXC path:"  "$LXC_DIR"
printf "  %-14s %s\n" "Backup:"    "$BACKUP_DIR"
echo

yesno "Создать контейнер с этими параметрами?" "y" || {
    echo "Отменено."
    exit 0
}

########################################################################
# PRE-FLIGHT
########################################################################

header "Pre-flight"

DEVICE="/dev/${VG}/${NAME}"

if lvs "${VG}/${NAME}" >/dev/null 2>&1; then
    die "LV ${VG}/${NAME} уже существует"
fi

if mountpoint -q "$LXC_DIR" 2>/dev/null; then
    die "$LXC_DIR уже является mountpoint"
fi

if [ -e "$LXC_DIR" ]; then
    echo
    warn "$LXC_DIR уже существует."

    du -sh "$LXC_DIR" 2>/dev/null || true
    ls -la "$LXC_DIR" 2>/dev/null | head -20 || true

    echo

    if yesno "Удалить старый каталог $LXC_DIR?" "n"; then
        rm -rf "$LXC_DIR"
    else
        die "Каталог уже существует"
    fi
fi

########################################################################
# DOWNLOAD TEMPLATE COMPATIBILITY
########################################################################

header "Проверка lxc-download"

DOWNLOAD_TEMPLATE=""

for candidate in \
    /usr/share/lxc/templates/lxc-download \
    /usr/local/share/lxc/templates/lxc-download
do
    if [ -f "$candidate" ]; then
        DOWNLOAD_TEMPLATE="$candidate"
        break
    fi
done

[ -n "$DOWNLOAD_TEMPLATE" ] || \
    die "Не найден шаблон lxc-download"

echo "Template:"
echo "  $DOWNLOAD_TEMPLATE"
echo

SUPPORT_SERVER=0
SUPPORT_VARIANT=0

if grep -q -- '--server' "$DOWNLOAD_TEMPLATE"; then
    SUPPORT_SERVER=1
    ok "Поддерживается: --server"
else
    warn "--server не найден в этом lxc-download"
fi

if grep -q -- '--variant' "$DOWNLOAD_TEMPLATE"; then
    SUPPORT_VARIANT=1
    ok "Поддерживается: --variant"
else
    warn "--variant не найден в этом lxc-download"
fi

if [ "$VARIANT" != "default" ] &&
   [ "$SUPPORT_VARIANT" -eq 0 ]; then
    die "Этот lxc-download не поддерживает variant=$VARIANT. Выбери default."
fi

########################################################################
# ROLLBACK
########################################################################

LV_CREATED=0
TARGET_MOUNTED=0
FSTAB_ADDED=0
ROUTE_CREATED=0
FINISHED=0

ROUTE_SERVICE="/etc/systemd/system/lxc-route-${NAME}.service"

rollback() {
    rc=$?

    rm -f "$INDEX_TMP" 2>/dev/null || true

    if [ "$rc" -ne 0 ] && [ "$FINISHED" -eq 0 ]; then

        echo
        echo "${RED}${BOLD}Ошибка. Откат незавершённого контейнера...${RESET}"

        if [ "$ROUTE_CREATED" -eq 1 ]; then
            systemctl disable \
                "lxc-route-${NAME}.service" \
                >/dev/null 2>&1 || true

            rm -f "$ROUTE_SERVICE" || true
            systemctl daemon-reload || true
        fi

        if [ "$TARGET_MOUNTED" -eq 1 ]; then
            umount "$LXC_DIR" 2>/dev/null || true
        fi

        if [ "$FSTAB_ADDED" -eq 1 ]; then
            sed -i \
                "\|${DEVICE} ${LXC_DIR} xfs |d" \
                /etc/fstab
        fi

        if [ "$LV_CREATED" -eq 1 ]; then
            lvremove -fy "${VG}/${NAME}" \
                >/dev/null 2>&1 || true
        fi

        rm -rf "$LXC_DIR" 2>/dev/null || true
    fi

    trap - EXIT
    exit "$rc"
}

