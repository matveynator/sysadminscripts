#
# 1. curl -4
# 2. если curl не смог -> автоматически ставим GURL
# 3. скачиваем через GURL
# 4. lxc-create -t local распаковывает локальные файлы
########################################################################

header "Загрузка образа"

########################################################################
# GURL INSTALLER
########################################################################

install_gurl() {

    if command -v gurl >/dev/null 2>&1; then
        echo "GURL уже установлен:"
        command -v gurl
        gurl -V 2>/dev/null || true
        return 0
    fi

    header "Установка GURL"

    local uname_m
    local gurl_arch
    local gurl_url
    local gurl_tmp

    uname_m="$(uname -m)"

    case "$uname_m" in
        x86_64|amd64)
            gurl_arch="amd64"
            ;;
        i386|i486|i586|i686|x86)
            gurl_arch="386"
            ;;
        aarch64|arm64)
            gurl_arch="arm64"
            ;;
        armv4*|armv5*|armv6*|armv7*|armv8l|arm)
            gurl_arch="arm"
            ;;
        loongarch64|loong64)
            gurl_arch="loong64"
            ;;
        mips64el|mips64le)
            gurl_arch="mips64le"
            ;;
        mips64)
            gurl_arch="mips64"
            ;;
        mipsel|mipsle)
            gurl_arch="mipsle"
            ;;
        mips)
            gurl_arch="mips"
            ;;
        ppc64le|powerpc64le)
            gurl_arch="ppc64le"
            ;;
        ppc64|powerpc64)
            gurl_arch="ppc64"
            ;;
        riscv64)
            gurl_arch="riscv64"
            ;;
        s390x)
            gurl_arch="s390x"
            ;;
        *)
            die "GURL: неизвестная архитектура $uname_m"
            ;;
    esac

    # У GURL официальный latest endpoint доступен по HTTP,
    # что полезно как bootstrap при проблемах со старым TLS.
    gurl_url="http://files.zabiyaka.net/gurl/latest/linux/${gurl_arch}/gurl"
    gurl_tmp="/tmp/gurl-install.$$"

    rm -f "$gurl_tmp"

    echo "Platform: linux/${gurl_arch}"
    echo "URL:"
    echo "  $gurl_url"
    echo

    echo "Пробуем установить GURL через wget..."

    if wget \
        --timeout=30 \
        --tries=3 \
        --progress=bar:force \
        -O "$gurl_tmp" \
        "$gurl_url"
    then
        :
    else
        echo
        warn "wget не смог скачать GURL."
        echo "Пробуем bootstrap через curl..."
        echo

        rm -f "$gurl_tmp"

        if ! curl \
            -fL \
            --connect-timeout 15 \
            --max-time 120 \
            --progress-bar \
            -o "$gurl_tmp" \
            "$gurl_url"
        then
            rm -f "$gurl_tmp"
            die "Не удалось установить GURL ни через wget, ни через curl"
        fi
    fi

    [ -s "$gurl_tmp" ] || \
        die "Скачанный GURL пустой"

    install \
        -m 0755 \
        "$gurl_tmp" \
        /bin/gurl

    rm -f "$gurl_tmp"

    command -v gurl >/dev/null 2>&1 || \
        die "GURL установлен, но команда gurl не найдена"

    echo
    ok "GURL установлен: $(command -v gurl)"

    gurl -V 2>/dev/null || true
}

########################################################################
# DOWNLOAD CURL -> GURL FALLBACK
########################################################################

download_image_file() {

    local url="$1"
    local destination="$2"
    local description="$3"

    local part="${destination}.part"

    rm -f "$destination" "$part"

    echo
    echo "${BOLD}${description}${RESET}"
    echo
    echo "$url"
    echo

    ####################################################################
    # CURL FIRST
    ####################################################################

    echo "${CYAN}Метод 1: curl IPv4${RESET}"
    echo

    if curl \
        -4 \
        --fail \
        --location \
        --retry 2 \
        --retry-delay 2 \
        --connect-timeout 15 \
        --max-time 1800 \
        --progress-bar \
        --output "$part" \
        "$url"
    then

        if [ -s "$part" ]; then

            mv "$part" "$destination"

            echo
            ok "curl: скачано"

            ls -lh "$destination"

            return 0
        fi
    fi

    echo
    warn "curl не смог скачать $description"
    echo

    rm -f "$part"

    ####################################################################
    # GURL FALLBACK
    ####################################################################

    install_gurl

    echo
    echo "${CYAN}Метод 2: GURL${RESET}"
    echo

    if gurl \
        -fail \
        -L \
        -m 1h \
        -o "$part" \
        "$url"
    then

        if [ -s "$part" ]; then

            mv "$part" "$destination"

            echo
            ok "GURL: скачано"

            ls -lh "$destination"

            return 0
        fi
    fi

    rm -f "$part"

    die "Не удалось скачать $url ни через curl, ни через GURL"
}

