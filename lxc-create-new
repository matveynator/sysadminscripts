    2>/dev/null || true

CHROOT

########################################################################
# FINAL SYSTEMD NETWORK DISABLE
#
# Делаем ПОСЛЕ apt-get install.
#
# 1. systemctl --root=... disable
# 2. systemctl disable через chroot как дополнительная попытка
# 3. физически удаляем enable-symlink'и
# 4. проверяем результат
########################################################################

header "Отключение systemd-networkd / systemd-resolved"

if [ -x "$ROOTFS/bin/systemctl" ] || \
   [ -x "$ROOTFS/usr/bin/systemctl" ]
then

    echo "RootFS:"
    echo "  $ROOTFS"
    echo

    ####################################################################
    # OFFLINE SYSTEMCTL
    ####################################################################

    echo "${BOLD}systemctl --root:${RESET}"
    echo

    echo "  systemctl disable systemd-networkd"
    systemctl \
        --root="$ROOTFS" \
        disable \
        systemd-networkd.service \
        2>&1 || true

    echo
    echo "  systemctl disable systemd-resolved"
    systemctl \
        --root="$ROOTFS" \
        disable \
        systemd-resolved.service \
        2>&1 || true

    ####################################################################
    # CHROOT FALLBACK
    ####################################################################

    echo
    echo "${BOLD}chroot fallback:${RESET}"
    echo

    chroot "$ROOTFS" /bin/sh -c '
        systemctl disable systemd-networkd 2>/dev/null || true
        systemctl disable systemd-resolved 2>/dev/null || true
    '

    ####################################################################
    # FORCE REMOVE ENABLE LINKS
    #
    # disable должен делать именно это сам.
    # Если старый systemctl/chroot почему-либо этого не сделал —
    # удаляем ссылки вручную.
    ####################################################################

    echo
    echo "${BOLD}Удаление оставшихся enable-ссылок:${RESET}"
    echo

    # Самые типичные ссылки.
    rm -f \
        "$ROOTFS/etc/systemd/system/multi-user.target.wants/systemd-networkd.service" \
        "$ROOTFS/etc/systemd/system/sysinit.target.wants/systemd-networkd.service" \
        "$ROOTFS/etc/systemd/system/network-online.target.wants/systemd-networkd-wait-online.service" \
        "$ROOTFS/etc/systemd/system/dbus-org.freedesktop.network1.service" \
        "$ROOTFS/etc/systemd/system/multi-user.target.wants/systemd-resolved.service" \
        "$ROOTFS/etc/systemd/system/sysinit.target.wants/systemd-resolved.service" \
        "$ROOTFS/etc/systemd/system/dbus-org.freedesktop.resolve1.service" \
        2>/dev/null || true

    # Ищем любые остальные symlink'и в /etc/systemd/system,
    # указывающие именно на эти unit'ы.
    if [ -d "$ROOTFS/etc/systemd/system" ]; then

        find "$ROOTFS/etc/systemd/system" \
            -type l \
            \( \
                -lname '*systemd-networkd.service' \
                -o \
                -lname '*systemd-resolved.service' \
            \) \
            -print \
            -delete \
            2>/dev/null || true

    fi

    ####################################################################
    # RESOLV.CONF
    #
    # После отключения systemd-resolved не оставляем ссылку
    # на /run/systemd/resolve/stub-resolv.conf.
    ####################################################################

    if [ -L "$ROOTFS/etc/resolv.conf" ]; then

        RESOLV_TARGET="$(
            readlink "$ROOTFS/etc/resolv.conf" 2>/dev/null || true
        )"

        case "$RESOLV_TARGET" in
            *systemd/resolve/*)

                echo
                echo "Исправляю /etc/resolv.conf после отключения resolved"

                rm -f "$ROOTFS/etc/resolv.conf"

                cp -L \
                    /etc/resolv.conf \
                    "$ROOTFS/etc/resolv.conf"
                ;;

        esac
    fi

    ####################################################################
    # VERIFY
    ####################################################################

    echo
    echo "${BOLD}Проверка:${RESET}"
    echo

    NETWORKD_STATE="$(
        systemctl \
            --root="$ROOTFS" \
            is-enabled \
            systemd-networkd.service \
            2>/dev/null || true
    )"

    RESOLVED_STATE="$(
        systemctl \
            --root="$ROOTFS" \
            is-enabled \
            systemd-resolved.service \
            2>/dev/null || true
    )"

    echo "  systemd-networkd: ${NETWORKD_STATE:-disabled}"
    echo "  systemd-resolved: ${RESOLVED_STATE:-disabled}"

    echo
    echo "Оставшиеся ссылки:"
    echo

    find "$ROOTFS/etc/systemd/system" \
        -type l \
        \( \
            -lname '*systemd-networkd.service' \
            -o \
            -lname '*systemd-resolved.service' \
        \) \
        -print \
        2>/dev/null || true

    echo

else

    warn "В контейнере нет systemctl"

fi

########################################################################
# FSTAB
########################################################################

header "Добавление в /etc/fstab"

FSTAB_LINE="${DEVICE} ${LXC_DIR} xfs auto,nofail,noatime,rw 0 0"

if ! grep -Fqx "$FSTAB_LINE" /etc/fstab; then
    echo "$FSTAB_LINE" >> /etc/fstab
    FSTAB_ADDED=1
fi

########################################################################
# HOST /32 ROUTES BEFORE LXC AUTOSTART
########################################################################

if [ "$PREFIX" = "32" ]; then

    header "Постоянные /32 маршруты LXC"

    ROUTES_DIR="/etc/lxc"
    ROUTES_FILE="/etc/lxc/public-routes.conf"
    ROUTES_SCRIPT="/usr/local/sbin/lxc-public-routes"
    ROUTES_UNIT="/etc/systemd/system/lxc-public-routes.service"

    mkdir -p "$ROUTES_DIR"

    touch "$ROUTES_FILE"

    ####################################################################
    # Сначала собираем маршруты из уже существующих LXC.
    #
    # Таким образом старые контейнеры тоже автоматически попадут
    # в ранний boot routing.
    ####################################################################

    ROUTES_TMP="$(mktemp)"

    # Сохраняем уже записанные маршруты.
    cat "$ROUTES_FILE" >> "$ROUTES_TMP" 2>/dev/null || true

    for CFG in /var/lib/lxc/*/config
    do
        [ -f "$CFG" ] || continue

        CFG_BRIDGE="$(
            awk -F'=' '
                /^[[:space:]]*lxc\.net\.0\.link[[:space:]]*=/ {
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
                    print $2
                    exit
                }
            ' "$CFG"
        )"

        CFG_IP="$(
            awk -F'=' '
                /^[[:space:]]*lxc\.net\.0\.ipv4\.address[[:space:]]*=/ {
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2)
                    print $2
                    exit
                }
            ' "$CFG"
        )"

        case "$CFG_IP" in
            */32)
                [ -n "$CFG_BRIDGE" ] && \
                    echo "$CFG_IP $CFG_BRIDGE" >> "$ROUTES_TMP"
                ;;
        esac
    done

    # Текущий создаваемый контейнер.
    echo "${IPV4}/32 ${BRIDGE}" >> "$ROUTES_TMP"

    # Убираем пустые строки и дубли.
    awk '
        NF >= 2 && !seen[$1 " " $2]++ {
            print $1, $2
        }
    ' "$ROUTES_TMP" > "$ROUTES_FILE"

    rm -f "$ROUTES_TMP"

    ####################################################################
    # HOST ROUTE SCRIPT
    #
    # Эквивалент:
    #
    #   up ip r a 213.133.127.244 dev br0
    #   up ip r a 144.76.121.189 dev br0
    #
    # Только используем "replace", чтобы reboot/restart был idempotent.
    ####################################################################

    cat > "$ROUTES_SCRIPT" <<'EOF'
#!/bin/bash
set -Eeuo pipefail

ROUTES_FILE="/etc/lxc/public-routes.conf"

[ -f "$ROUTES_FILE" ] || exit 0

while read -r CIDR BRIDGE REST
do
    [ -n "${CIDR:-}" ] || continue
    [ -n "${BRIDGE:-}" ] || continue

    case "$CIDR" in
        \#*)
            continue
            ;;
    esac

    echo "LXC route: $CIDR -> $BRIDGE"

    # Ждём появления bridge.
    FOUND=0

    for i in $(seq 1 100)
    do
        if ip link show "$BRIDGE" >/dev/null 2>&1; then
            FOUND=1
            break
        fi

        sleep 0.1
    done

    if [ "$FOUND" -ne 1 ]; then
        echo "ERROR: bridge $BRIDGE not found" >&2
        exit 1
    fi

    ip link set "$BRIDGE" up || true

    ip route replace \
        "$CIDR" \
        dev "$BRIDGE"

done < "$ROUTES_FILE"
EOF

    chmod +x "$ROUTES_SCRIPT"

    ####################################################################
    # SYSTEMD:
    #
    # network -> routes -> LXC autostart
    ####################################################################

    cat > "$ROUTES_UNIT" <<EOF
[Unit]
Description=Install public /32 routes for LXC containers
Wants=network-online.target
After=local-fs.target network-online.target networking.service
Before=lxc.service lxc-autostart.service

[Service]
Type=oneshot
ExecStart=${ROUTES_SCRIPT}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload

    systemctl enable \
        lxc-public-routes.service

    # Применяем сразу и одновременно проверяем конфиг.
    systemctl restart \
        lxc-public-routes.service

    echo
    echo "${BOLD}Маршруты:${RESET}"
    echo

    cat "$ROUTES_FILE"

    echo
    echo "${BOLD}Таблица маршрутизации хоста:${RESET}"
    echo

    while read -r CIDR ROUTE_BRIDGE REST
    do
        [ -n "${CIDR:-}" ] || continue

        ip route show "$CIDR" || true

    done < "$ROUTES_FILE"

fi

########################################################################
# FINISH
########################################################################

FINISHED=1

rm -f "$INDEX_TMP"

trap - EXIT INT TERM

header "ГОТОВО"

echo
printf "  %-15s %s\n" "Container:" "$NAME"
printf "  %-15s %s\n" "Image:"     "$DISTRO $RELEASE $ARCH $VARIANT"
printf "  %-15s %s\n" "Disk:"      "$DISK"
printf "  %-15s %s\n" "RAM:"       "$MEMORY"
printf "  %-15s %s\n" "CPU:"       "$CPUSET"
printf "  %-15s %s\n" "IPv4:"      "$IPV4/$PREFIX"
printf "  %-15s %s\n" "Gateway:"   "$GATEWAY"
printf "  %-15s %s\n" "Bridge:"    "$BRIDGE"
printf "  %-15s %s\n" "Device:"    "$DEVICE"
printf "  %-15s %s\n" "Rootfs:"    "$ROOTFS"
echo

df -h "$LXC_DIR"

echo
lxc-ls -f | grep -E "^NAME|^${NAME}[[:space:]]" || true

echo
echo "${BOLD}Запуск:${RESET}"
echo "  lxc-start -n $NAME"

echo
echo "${BOLD}Войти:${RESET}"
echo "  lxc-attach -n $NAME"

echo
echo "${BOLD}Остановить:${RESET}"
echo "  lxc-stop -n $NAME"

echo

if yesno "Запустить контейнер сейчас?" "y"; then

    ip route replace \
        "${IPV4}/${PREFIX}" \
        dev "$BRIDGE" \
        2>/dev/null || true

    lxc-start -n "$NAME"

    sleep 2

    ####################################################################
    # FINAL LIVE SYSTEMD DISABLE
    ####################################################################

    echo
    echo "${BOLD}Финальное отключение networkd/resolved в запущенном контейнере:${RESET}"
    echo

    lxc-attach         -n "$NAME"         --         systemctl disable systemd-networkd         2>&1 || true

    lxc-attach         -n "$NAME"         --         systemctl disable systemd-resolved         2>&1 || true

    echo
    echo "Проверка:"
    echo

    echo -n "  systemd-networkd: "
    lxc-attach         -n "$NAME"         --         systemctl is-enabled systemd-networkd         2>/dev/null || true

    echo -n "  systemd-resolved: "
    lxc-attach         -n "$NAME"         --         systemctl is-enabled systemd-resolved         2>/dev/null || true


    echo
    lxc-ls -f | grep -E "^NAME|^${NAME}[[:space:]]" || true

    echo
    echo "Проверка адреса:"
    lxc-attach -n "$NAME" -- ip -br addr 2>/dev/null || true

    echo
    echo "Проверка маршрута:"
    lxc-attach -n "$NAME" -- ip route 2>/dev/null || true

    echo
    echo "Проверка default gateway:"
    lxc-attach -n "$NAME" -- ip route show default 2>/dev/null || true

    echo
    echo "Ожидаемый gateway:"
    echo "  $GATEWAY"
    lxc-stop -n "$NAME"
    lxc-start -n "$NAME"
fi
